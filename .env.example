# 复制为 .env 后填写真实值；.env 已在 .gitignore 中，不要提交
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_REPAIR_RETRIES=1
MAX_EXTRACT_CLAUSES=40

CHECKPOINT_BACKEND=sqlite
CHECKPOINT_SQLITE_PATH=.data/checkpoints.sqlite
HITL_TIMEOUT_MINUTES=30

# HITL 待审批时间戳与上传暂存（跨进程超时判定需要落盘，勿指向临时目录）
PENDING_DIR=.data/pending
UPLOAD_DIR=.data/uploads

# RAG（ADR-007 / ADR-008）：默认关闭；知识库不可用时会自动退化为纯规则解释
RAG_ENABLED=false
RAG_KNOWLEDGE_DIR=data/knowledge
RAG_TOP_K=3
RAG_MIN_SCORE=1.0

# 多智能体专家 + 工具调用（ADR-015）：默认关闭；关闭时图行为与确定性主干完全一致
# AGENTS_ENABLED=true 才会按条款类型并行跑“付款 / 交付 / 争议”三个专家（只提候选意见，不判级）
AGENTS_ENABLED=false
# TOOLS_ENABLED=true 才会在解释前做一次只读检索（本地 4 个工具 + 可选 MCP）
TOOLS_ENABLED=false
MAX_TOOL_CALLS=3
# MCP（stdio / JSON-RPC）服务器，JSON 数组；只允许本地命令，不执行包内脚本
# 例：[{"name":"docs","command":"python","args":["scripts/mcp_docs.py"]}]
MCP_SERVERS=
MCP_TIMEOUT_SECONDS=10

MAX_UPLOAD_MB=30
MAX_CONTRACT_CHARS=200000
MAX_PAGES=200

# 扫描件 / 图片 PDF 的本地 OCR（RapidOCR + pypdfium2，离线推理）
OCR_ENABLED=true
OCR_MAX_PAGES=20
OCR_RENDER_SCALE=2.2

# 账号 / 审查记录 / Skill / BYOK（ADR-013）：本地 SQLite + 本机密文盒主密钥
USER_DB_PATH=.data/app.sqlite
USER_SECRET_PATH=.data/secret.key
SESSION_TTL_DAYS=7
